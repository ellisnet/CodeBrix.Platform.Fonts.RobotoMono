<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.Platform.Fonts.RobotoMono</AssemblyName>
    <RootNamespace>CodeBrix.Platform.Fonts.RobotoMono</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DefaultLanguage>en-US</DefaultLanguage>
    <IncludeContentInPack>true</IncludeContentInPack>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <!-- NuGet package properties -->
  <PropertyGroup>
    <PackageId>CodeBrix.Platform.Fonts.RobotoMono.OflLicenseForever</PackageId>
    <Product>CodeBrix.Platform.Fonts.RobotoMono</Product>
    <Title>CodeBrix.Platform.Fonts.RobotoMono</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>A .NET 10 redistribution of the Roboto Mono monospace font family, packaged for the CodeBrix family. Ships the Roboto Mono variable font plus 10 static .ttf files (Light/Regular/Medium/SemiBold/Bold weights in Normal/Italic styles), and three companion fonts that extend coverage beyond what Roboto Mono itself carries: Noto Sans Mono (polytonic Greek), Iosevka (the Armenian script, in the Extended width grade that matches Roboto Mono's 0.6 em character advance), and Noto Sans Georgian (the Georgian script). Includes a font .ttf.manifest JSON per family and a buildTransitive .targets file that prunes the unused static font set at consumer-build time. The whole package, code and fonts alike, is distributed under the SIL Open Font License 1.1.</Description>
    <PackageLicenseExpression>OFL-1.1</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.Platform.Fonts.RobotoMono</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.Platform.Fonts.RobotoMono</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors. Roboto Mono font (c) 2015 The Roboto Mono Project Authors; Noto Sans Mono and Noto Sans Georgian fonts (c) 2022 The Noto Project Authors; Iosevka font (c) 2015-2026 Renzhi Li; all distributed under SIL OFL 1.1.</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>RobotoMono;NotoSansMono;Iosevka;font;fonts;monospace;Platform;variable-font;SIL-OFL;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png"     Pack="true" PackagePath="" />
    <None Include="..\..\README.md"                  Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt"           Pack="true" PackagePath="" />
    <!-- The font's self-description for CodeBrix.Develop's New Application experience:
         how to reference this font in a generated application, and which software-keyboard
         layouts its glyph coverage actually supports. -->
    <None Include="..\..\CODEBRIX-DEVELOP.json"      Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt"    Pack="true" PackagePath="" />
    <!-- One OFL text per upstream font project; the license body is identical,
         the copyright headers differ. -->
    <None Include="..\..\OFL-Roboto.txt"             Pack="true" PackagePath="" />
    <None Include="..\..\OFL-Noto.txt"               Pack="true" PackagePath="" />
    <None Include="..\..\OFL-Iosevka.txt"            Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CodeBrix.Platform.Fonts.RobotoMono.uprimarker"
          Pack="true"
          PackagePath="lib/net10.0" />
    <None Include="Fonts/*.ttf"
          Pack="true"
          PackagePath="lib/net10.0/CodeBrix.Platform.Fonts.RobotoMono/Fonts/" />
    <None Include="Fonts/*.ttf.manifest"
          Pack="true"
          PackagePath="lib/net10.0/CodeBrix.Platform.Fonts.RobotoMono/Fonts/" />
    <None Include="buildTransitive\**\*"
          Pack="true"
          PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>
