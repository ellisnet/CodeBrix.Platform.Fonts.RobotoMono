<Project>
    <!--
      Prunes the redundant static Roboto Mono (and companion) fonts at consumer
      build time, hooking into the CodeBrix.Platform asset pipeline.

      This target hooks AfterTargets="_CodeBrixAddLibraryAssets" (the asset
      target defined by the CodeBrix.Platform UI build tasks). Hooking that
      target is what makes this prune actually run during a CodeBrix.Platform
      app build.

      Behaviour:
        * On platforms that do NOT support the font manifest, the static font
          files (their names contain a dash) are removed, leaving only the
          dash-free fonts RobotoMono.ttf, NotoSansMono.ttf, Iosevka.ttf and
          NotoSansGeorgian.ttf.
        * Those four fonts are intentionally NEVER removed. Consumers (and the
          CodeBrix.Platform default-font configuration) reference them by
          direct paths such as
          ms-appx:///CodeBrix.Platform.Fonts.RobotoMono/Fonts/RobotoMono.ttf,
          so they must stay present on every platform (including manifest-capable
          ones) for those references to resolve. The companion fonts are named
          without a dash for exactly this reason: they are the fallback families
          that supply the polytonic Greek, Armenian and Georgian coverage
          Roboto Mono does not carry, and losing them would silently drop those
          scripts. Note that Iosevka.ttf is a static Regular instance, not a
          variable font — Iosevka publishes no variable-font .ttf — so on
          platforms without manifest support the Armenian script renders at
          Regular weight only.
    -->
    <Target Name="CodeBrixRemoveUnusedRobotoMono" AfterTargets="_CodeBrixAddLibraryAssets">
        <ItemGroup>
            <!-- Static font files contain a dash in the name, so that's what we remove. -->
            <!-- For platforms that already support variable fonts, we remove the static font files. -->
            <_AllChildProjectItemsWithTargetPath
                Remove="$(MSBuildThisFileDirectory)..\..\lib\net10.0\CodeBrix.Platform.Fonts.RobotoMono\Fonts\**-**.ttf"
                Condition="'$(SupportsFontManifest)'!='true'" />
        </ItemGroup>
    </Target>
</Project>
